+// Asynchronous-read register file mapped to distributed RAM.
+// Existing validity state defines usable entries; runtime reset does not erase RAM.
+module register_file #(parameter DATA_L=32, ADDR_L=5)(
+ input clk,rstn,wr_en,input [ADDR_L-1:0] wr_addr,input [DATA_L-1:0] wr_data,
+ input rd_en,input [ADDR_L-1:0] rd_addr,output logic [DATA_L-1:0] rd_data);
+ localparam DEPTH=2**ADDR_L;
+ (* ram_style="distributed" *) logic [DATA_L-1:0] mem_rf [0:DEPTH-1];
+ always_comb rd_data=rd_en ? mem_rf[rd_addr] : '0;
+ always_ff @(posedge clk) if(rstn && wr_en) mem_rf[wr_addr]<=wr_data;
 endmodule
